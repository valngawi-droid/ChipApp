{
  "name": "chipapp",
  "version": "4.2.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "^57.0.10",
    "@expo/vector-icons": "^15.1.1",
    "@react-navigation/bottom-tabs": "^7.18.16",
    "@react-navigation/native": "^7.3.16",
    "@react-navigation/native-stack": "^7.18.8",
    "expo": "~57.0.13",
    "expo-haptics": "^57.0.1",
    "expo-linear-gradient": "^57.0.1",
    "expo-localization": "^57.0.1",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "^3.2.1",
    "react-native-reanimated": "^4.5.3",
    "react-native-safe-area-context": "^5.9.0",
    "react-native-screens": "^4.27.0",
    "react-native-web": "^0.21.2",
    "socket.io-client": "^4.8.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "^57.0.7",
    "concurrently": "^10.0.5",
    "jsdom": "^30.0.1",
    "pngjs": "^7.0.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web --port 3000 --host lan",
    "backend": "node backend/server.js",
    "dev": "concurrently -n api,app -c green,cyan \"npm run backend\" \"npm run web\"",
    "tunnel": "cloudflared tunnel run --token $CLOUDFLARE_TUNNEL_TOKEN",
    "typecheck": "tsc --noEmit",
    "assets:sounds": "node scripts/generate-sounds.js",
    "assets:stickers": "node scripts/generate-stickers.js",
    "size": "node scripts/size-report.js",
    "test:backend": "node scripts/test-backend.js",
    "test:smoke": "node scripts/smoke-web.js \"http://localhost:3000/index.bundle?platform=web&dev=false\"",
    "test:flow": "node scripts/smoke-flow.js",
    "test:ui": "node scripts/audit-ui.js",
    "test:i18n": "node scripts/audit-i18n.js",
    "test": "npm run typecheck && npm run test:backend && npm run test:smoke && npm run test:flow && npm run test:ui && npm run test:i18n && npm run test:untranslated",
    "test:untranslated": "node scripts/audit-untranslated.js",
    "apk:local": "bash scripts/build-apk-local.sh",
    "apk:eas": "eas build --platform android --profile apk"
  },
  "private": true,
  "description": "ChipApp — WhatsApp-for-iOS-parity messenger built with Expo, React Native and Socket.io"
}
