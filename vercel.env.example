# Template ENV untuk Vercel + NeonDB Pooler - chiperx.cyou
# Pooler URL recommended untuk Vercel serverless (pakai -pooler host + channel_binding)
# Copy file ini jadi vercel.env dan isi DATABASE_URL + PASSWORD asli dari Neon Dashboard
# Cara import di Vercel: New Project -> Environment Variables -> Import .env -> pilih vercel.env

# === NEON POSTGRES — URL + PASSWORD ENV (harus ada) ===
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-xxx-pooler.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
POSTGRES_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-xxx-pooler.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
NEON_DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-xxx-pooler.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:YOUR_PASSWORD@ep-xxx.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require

# Password env (harus ada - sesuai request user)
POSTGRES_PASSWORD=YOUR_PASSWORD
DATABASE_PASSWORD=YOUR_PASSWORD
NEON_DB_PASSWORD=YOUR_PASSWORD
PGPASSWORD=YOUR_PASSWORD
DB_PASSWORD=YOUR_PASSWORD

# === Neon Auth (optional) ===
NEON_AUTH_URL=https://ep-xxx.neonauth.c-5.us-east-2.aws.neon.tech/neondb/auth
NEON_JWKS_URL=https://ep-xxx.neonauth.c-5.us-east-2.aws.neon.tech/neondb/auth/.well-known/jwks.json

# === JWT & Google ===
JWT_SECRET=ganti_dengan_random_32_char_minimal
POSTGRES_JWT_SECRET=ganti_dengan_random_32_char_minimal
GOOGLE_CLIENT_ID=68960926780-ti5kaoq71pvg7mb54am9q4176nvcee2i.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_CLIENT_ID=68960926780-ti5kaoq71pvg7mb54am9q4176nvcee2i.apps.googleusercontent.com

# === Domain & CORS ===
ALLOWED_ORIGINS=https://chiperx.cyou,https://www.chiperx.cyou

# === Node ===
NODE_ENV=production
HOST=0.0.0.0
PORT=10000
ALLOW_DEMO_AUTH=true
CORS_STRICT=false
MAX_MESSAGES_PER_ROOM=1000
ALLOW_DB_CLEAR=false
REDIRECT_WWW_TO_APEX=false
DATA_DIR=./backend/data
EXPO_PUBLIC_API_URL=
RENDER_BACKEND_URL=
