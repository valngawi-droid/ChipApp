# Server
PORT=4000
HOST=0.0.0.0
JWT_SECRET=ganti_dengan_string_acak_panjang
ALLOW_DEMO_AUTH=true

# Google OAuth (dari Google Cloud Console)
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com

# MySQL — aktifkan persistence dengan salah satu:
# Opsi A: connection string
DATABASE_URL=mysql://chipapp:chipapp_pass@127.0.0.1:3306/chipapp
# Opsi B: variabel terpisah
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=chipapp
# MYSQL_PASSWORD=chipapp_pass
# MYSQL_DATABASE=chipapp

# Tanpa MySQL, backend otomatis pakai in-memory (data reset saat restart).
HISTORY_LIMIT=500
