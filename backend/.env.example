# ChipApp backend configuration
# Copy to .env and fill in real values. NEVER commit the populated .env.

# Google OAuth 2.0 web client ID used to verify incoming ID tokens
GOOGLE_CLIENT_ID=68960926780-ti5kaoq71pvg7mb54am9q4176nvcee2i.apps.googleusercontent.com

# Signing key for ChipApp session JWTs — replace with a long random value in production
JWT_SECRET=change_me_to_a_long_random_secret

# HTTP listener — on Render PORT is injected as 10000, locally keep 4000
PORT=4000
HOST=0.0.0.0

# Set to false to disable the sample-profile sign-in endpoint
ALLOW_DEMO_AUTH=true

# === Custom domain / CORS config for Render + Vercel ===
# Primary personal domain: chiperx.cyou (only)
ALLOWED_ORIGINS=https://chiperx.cyou,https://www.chiperx.cyou

# === Persistent Database — Vercel + NeonDB Pooler (free persistent) ===
# Pooler URL recommended for serverless (Vercel, Render free) — uses -pooler host + channel_binding
# Example from user:
# DATABASE_URL=postgresql://neondb_owner:npg_qzE8yRvAi6mK@ep-damp-union-ay6mz9ge-pooler.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Non-pooler direct fallback:
# DATABASE_URL_UNPOOLED=postgresql://neondb_owner:xxx@ep-damp-union-ay6mz9ge.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-xxx-pooler.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
POSTGRES_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-xxx-pooler.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
NEON_DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-xxx-pooler.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Neon Auth (optional) — for JWT via Neon Auth
# Auth URL: https://ep-damp-union-ay6mz9ge.neonauth.c-5.us-east-2.aws.neon.tech/neondb/auth
# JWKS URL: https://ep-damp-union-ay6mz9ge.neonauth.c-5.us-east-2.aws.neon.tech/neondb/auth/.well-known/jwks.json
NEON_AUTH_URL=https://ep-damp-union-ay6mz9ge.neonauth.c-5.us-east-2.aws.neon.tech/neondb/auth
NEON_JWKS_URL=https://ep-damp-union-ay6mz9ge.neonauth.c-5.us-east-2.aws.neon.tech/neondb/auth/.well-known/jwks.json

# File-based fallback (if DATABASE_URL not set) — ephemeral on free, persistent with Disk
DATA_DIR=./backend/data
# For Render Disk: DATA_DIR=/data

# Limits
MAX_MESSAGES_PER_ROOM=1000
ALLOW_DB_CLEAR=false

# CORS strict
CORS_STRICT=false

# Cloudflare Tunnel
CLOUDFLARE_TUNNEL_TOKEN=

# Render/Vercel production
NODE_ENV=production
# EXPO_PUBLIC_API_URL= (kosongkan = same-origin, atau set ke Render backend URL untuk realtime full)
# EXPO_PUBLIC_API_URL=https://chipapp-xxxx.onrender.com
# RENDER_BACKEND_URL=https://chipapp-xxxx.onrender.com

# Optional www -> apex redirect
# REDIRECT_WWW_TO_APEX=true
