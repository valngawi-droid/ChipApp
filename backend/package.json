{
  "name": "chipapp-backend",
  "version": "4.2.0",
  "private": true,
  "description": "ChipApp secure backend — Express, Socket.io, Google OAuth verification, JWT sessions",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "tunnel": "cloudflared tunnel run --token $CLOUDFLARE_TUNNEL_TOKEN",
    "termux:setup": "bash termux-setup.sh",
    "termux:start": "termux-wake-lock 2>/dev/null; node server.js",
    "lan": "node -e \"const os=require('os');const n=os.networkInterfaces();const ip=Object.values(n).flat().find(i=>i&&i.family==='IPv4'&&!i.internal);console.log('http://'+(ip?ip.address:'127.0.0.1')+':'+(process.env.PORT||4000))\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "google-auth-library": "^10.5.0",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "^4.8.3"
  },
  "engines": {
    "node": ">=18"
  }
}
